{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_REVIEWED_STAGING_WORKER_NAME",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "AURA_AUTH_STORE",
      "id": "REPLACE_WITH_STAGING_AUTH_KV_NAMESPACE_ID"
    },
    {
      "binding": "AURA_MEMORY_STORE",
      "id": "REPLACE_WITH_STAGING_MEMORY_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "AURA_TASKS_DB",
      "database_name": "REPLACE_WITH_STAGING_DATABASE_NAME",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "DAILY_NEWS_ENABLED": "false",
    "DAILY_NEWS_USE_AI": "false",
    "DAILY_NEWS_PREVIEW_ENABLED": "false",
    "DAILY_NEWS_AI_FREE_VERIFIED": "false"
  }
}
